<footer>
  <p>
    {{ t.footer.developer }}
    <a href="{{ links.license }}">Codetree Source-Available License 1.0</a>.
  </p>
  <p>
    <a href="{{ links.issues }}">{{ t.nav.support }}</a> ·
    {% if pageKey == 'privacy' %}
    <a href="{{ links.home }}">{{ t.nav.home }}</a> · <a href="{{ links.policySource }}">{{ t.policy.source }}</a>
    {% else %}
    <a href="{{ links.privacy }}">{{ t.footer.privacy }}</a>
    {% endif %}
  </p>
</footer>
