<section class="hero" aria-labelledby="intro">
  <p class="eyebrow">{{ t.hero.eyebrow }}</p>
  <h1 id="intro">{{ t.hero.title }}</h1>
  <p class="lead">{{ t.hero.lead }}</p>
  <p>{{ t.hero.body }}</p>
  <div class="actions">
    <a class="button" href="{{ links.store }}">{{ t.hero.download }}</a>
    <a class="button secondary" href="{{ links.guide }}">{{ t.hero.guide }}</a>
  </div>
</section>
{% set image = '1-github-tree' %}{% set alt = t.hero.alt %}{% set caption = t.hero.caption %}{% set lazy = false %}
